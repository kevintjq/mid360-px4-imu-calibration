<launch>
  <arg name="config" default="$(find mid360_px4_calibration)/config/offline_calibration.yaml"/>

  <node pkg="mid360_px4_calibration"
        type="offline_calibration_node.py"
        name="mid360_px4_offline_calibration"
        output="screen">
    <rosparam file="$(arg config)" command="load"/>
  </node>
</launch>
